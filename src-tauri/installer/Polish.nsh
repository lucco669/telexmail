; Tauri's additional messages, beyond NSIS's built-in Polish translations.
LangString addOrReinstall ${LANG_POLISH} "Zainstaluj ponownie"
LangString alreadyInstalled ${LANG_POLISH} "Telex jest już zainstalowany"
LangString alreadyInstalledLong ${LANG_POLISH} "${PRODUCTNAME} ${VERSION} jest już zainstalowany. Wybierz działanie i kliknij Dalej."
LangString appRunning ${LANG_POLISH} "${PRODUCTNAME} jest uruchomiony. Zamknij go i spróbuj ponownie."
LangString appRunningOkKill ${LANG_POLISH} "${PRODUCTNAME} jest uruchomiony.$\nKliknij OK, aby go zamknąć."
LangString chooseMaintenanceOption ${LANG_POLISH} "Wybierz działanie."
LangString choowHowToInstall ${LANG_POLISH} "Wybierz sposób instalacji ${PRODUCTNAME}."
LangString createDesktop ${LANG_POLISH} "Utwórz skrót na pulpicie"
LangString dontUninstall ${LANG_POLISH} "Zainstaluj bez odinstalowania"
LangString dontUninstallDowngrade ${LANG_POLISH} "Instalacja starszej wersji wymaga odinstalowania obecnej"
LangString failedToKillApp ${LANG_POLISH} "Nie udało się zamknąć ${PRODUCTNAME}. Zamknij go i spróbuj ponownie."
LangString installingWebview2 ${LANG_POLISH} "Instalowanie WebView2…"
LangString newerVersionInstalled ${LANG_POLISH} "Jest już zainstalowana nowsza wersja ${PRODUCTNAME}. Przed instalacją starszej wersji zalecamy odinstalowanie obecnej. Wybierz działanie i kliknij Dalej."
LangString older ${LANG_POLISH} "starsza"
LangString olderOrUnknownVersionInstalled ${LANG_POLISH} "Jest już zainstalowana $R4 wersja ${PRODUCTNAME}. Wybierz sposób instalacji i kliknij Dalej."
LangString silentDowngrades ${LANG_POLISH} "Instalacja starszej wersji jest wyłączona w trybie cichym. Użyj instalatora z oknem.$\n"
LangString unableToUninstall ${LANG_POLISH} "Nie udało się odinstalować aplikacji."
LangString uninstallApp ${LANG_POLISH} "Odinstaluj ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_POLISH} "Odinstaluj przed instalacją"
LangString unknown ${LANG_POLISH} "nieznana"
LangString webview2AbortError ${LANG_POLISH} "Nie udało się zainstalować WebView2. Telex go potrzebuje. Uruchom instalator ponownie."
LangString webview2DownloadError ${LANG_POLISH} "Nie udało się pobrać WebView2: $0"
LangString webview2DownloadSuccess ${LANG_POLISH} "Pobrano instalator WebView2"
LangString webview2Downloading ${LANG_POLISH} "Pobieranie instalatora WebView2…"
LangString webview2InstallError ${LANG_POLISH} "Instalacja WebView2 zakończyła się błędem $1"
LangString webview2InstallSuccess ${LANG_POLISH} "Zainstalowano WebView2"
LangString deleteAppData ${LANG_POLISH} "Usuń dane aplikacji"
