# Night Shift's leaderboard: server-only values. Put the real ones in .env.local and in Vercel
# (Settings > Environment Variables). Without all three the game works and the board says it is
# not connected.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Signs scored sessions and keys the rate-limit hashes. At least 32 characters, not the Supabase
# key. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NIGHT_SHIFT_SIGNING_SECRET=
