# Night Shift's leaderboard: server-only values. Put the real ones in .env.local and in Vercel
# (Settings > Environment Variables). Without all three the game works and the board says it is
# not connected.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Signs scored sessions and keys the rate-limit hashes. At least 32 characters, not the Supabase
# key. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NIGHT_SHIFT_SIGNING_SECRET=

# Counting (app/api/count, app/stats, app/api/downloads/snapshot) uses the same SUPABASE_URL and
# SUPABASE_SECRET_KEY, after supabase/migrations/20261017_telex_count.sql is applied.
# The private /stats page exists only with a password of 12 characters or more:
STATS_PASSWORD=
# Vercel sets this for its cron (vercel.json) when it is defined in the project; any long random value.
CRON_SECRET=
# Optional: raises GitHub's API rate limit for /stats and the snapshot (a token with no scopes).
GITHUB_TOKEN=
