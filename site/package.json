{
  "name": "telex-site",
  "version": "0.1.0",
  "private": true,
  "description": "Landing page for Telex, deployed on the home Coolify server",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/posters.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:seo": "node --test scripts/seo.test.mjs",
    "check:seo": "node scripts/check-seo-build.mjs",
    "posters": "node scripts/posters.mjs",
    "screens": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/screens.mjs",
    "demo": "node scripts/demo.mjs",
    "icons": "node scripts/icons.mjs",
    "themes": "node ../scripts/check-contrast.mjs --json lib/themes.json"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
