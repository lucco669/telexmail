{
  "name": "telexmail",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.9.11",
  "description": "Telex: a compact, keyboard-driven email client for Windows and Linux, built with Rust and Tauri",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "test": "cargo test -p telex-core",
    "tauri": "tauri",
    "set-version": "node scripts/set-version.mjs",
    "benchmark": "node scripts/benchmark/run.mjs",
    "benchmark:publish": "node scripts/benchmark/summarize.mjs",
    "benchmark:test": "node --test scripts/benchmark/summarize.test.mjs",
    "security": "node scripts/security/run.mjs",
    "security:test": "node --test scripts/security/guards.test.mjs scripts/security/reports.test.mjs scripts/security/release.test.mjs",
    "security:tools": "node scripts/security/install-gitleaks.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1"
  }
}
